# Don't ship node_modules or build outputs into the Docker context — Docker rebuilds them.
node_modules
**/node_modules
**/dist
**/.vite
**/.cache
**/.tsbuildinfo
**/tsconfig.tsbuildinfo

# Each app's image only needs its own source — exclude the other.
# (Both Dockerfiles use the monorepo root as build context.)
# If you flip the context to a single app, remove these.

# Local SQLite + outbox are not needed in any image.
data/app.db
data/app.db-journal
data/app.db-shm
data/app.db-wal
data/outbox/*.eml

# Editor / OS / git
.DS_Store
.idea
.vscode
.git
.gitignore
.github

# Logs
*.log
npm-debug.log*
